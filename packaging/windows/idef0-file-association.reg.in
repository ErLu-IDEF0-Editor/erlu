Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\.idef0]
@="Erlu.Document"
"Content Type"="application/x-erlu-idef0"

[HKEY_CURRENT_USER\Software\Classes\Erlu.Document]
@="IDEF0 Diagram"

[HKEY_CURRENT_USER\Software\Classes\Erlu.Document\DefaultIcon]
@="@APP_EXE@,0"

[HKEY_CURRENT_USER\Software\Classes\Erlu.Document\shell]

[HKEY_CURRENT_USER\Software\Classes\Erlu.Document\shell\open]

[HKEY_CURRENT_USER\Software\Classes\Erlu.Document\shell\open\command]
@="\"@APP_EXE@\" \"%1\""
